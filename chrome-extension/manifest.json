{
  "manifest_version": 3,
  "name": "J.A.R.V.I.S Browser Control",
  "version": "1.0.0",
  "description": "Connects your JARVIS dashboard to safe, user-requested Chrome tab controls.",
  "permissions": ["tabs", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "JARVIS Browser Access",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://llm-chat-app-template.hvrhypt5z2.workers.dev/*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }]
}